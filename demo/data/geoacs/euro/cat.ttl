PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>

demo:euro-geoacs
    a dcat:Catalog ;
    dcterms:hasPart
        demo:euro-geoac-01 ,
        demo:euro-geoac-02 ,
        demo:euro-geoac-03 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://mepgt> ;
            prov:hadRole <https://def.isotc211.org/codeset/RegisterRolesDemo/register-owner> ;
        ] ;
    schema:author <https://kurrawong.ai> ;
    schema:name "OGC Geoprocessing Activities Register" ;
.
