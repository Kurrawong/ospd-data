PREFIX ex: <http://example.org/>
PREFIX ont: <http://example.org/geoac>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ont:
    a owl:Ontology ;
    owl:versionIRI <http://example.org/geoac/1.0> ;
    owl:versionInfo "1.0" ;
    skos:historyNote "Created for the OGC Open Science Persistent Demonstrator registry catalogue."@en ;
    schema:codeRepository "https://github.com/Kurrawong/ospd-regcat"^^xsd:anyURI ;
    schema:copyrightHolder <https://kurrawong.ai> ;
    schema:copyrightNotice "Copyright 2026 KurrawongAI" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://kurrawong.ai> ;
    schema:dateCreated "2026-08-26"^^xsd:date ;
    schema:dateIssued "2026-08-26"^^xsd:date ;
    schema:dateModified "2026-08-26"^^xsd:date ;
    schema:description "An ontology defining geoprocessing activities for registry publication."@en ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:name "Geoprocessing Activity Model"@en ;
    schema:publisher <https://kurrawong.ai> ;
.

ex:GeoprocessingActivity
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "An activity that performs a geospatial processing operation."@en ;
    skos:example "A buffering operation is an instance of Geoprocessing Activity."@en ;
    skos:historyNote "Defined for the OGC Open Science Persistent Demonstrator registry catalogue."@en ;
    skos:prefLabel "Geoprocessing Activity"@en ;
.
