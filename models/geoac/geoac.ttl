PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatuses: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:GeoprocessingActivity
    a owl:Class ;
    rdfs:isDefinedBy ex:geoac ;
    rdfs:subClassOf prov:Activity ;
    skos:example "A buffering operation is an instance of Geoprocessing Activity." ;
    skos:historyNote "Defined for the OGC Open Science Persistent Demonstrator registry catalogue." ;
    schema:description "An activity that performs a geospatial processing operation." ;
    schema:name "Geoprocessing Activity" ;
.

skos:broader
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:example "An Ice Detection Geoprocessing Activity may have a Waterbody Detection indicated with this predicate" ;
    skos:scopeNote "Use this predicate to indicate that a Geoprocessing Activity has a more generic version" ;
    schema:description "Relates a concept to a concept that is more general in meaning." ;
    schema:name "has broader" ;
.

ex:geoac
    a owl:Ontology ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:models ;
            schema:value istatuses:stable ;
        ] ;
    owl:versionIRI <http://example.org/geoac/1.0> ;
    owl:versionInfo "1.0" ;
    skos:historyNote "Created for the OGC Open Science Persistent Demonstrator registry catalogue." ;
    schema:codeRepository "https://github.com/Kurrawong/ospd-regcat"^^xsd:anyURI ;
    schema:copyrightHolder <https://kurrawong.ai> ;
    schema:copyrightNotice "Copyright 2026 KurrawongAI" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://kurrawong.ai> ;
    schema:dateCreated "2026-08-26"^^xsd:date ;
    schema:dateIssued "2026-08-26"^^xsd:date ;
    schema:dateModified "2026-08-28"^^xsd:date ;
    schema:description "An ontology defining geoprocessing activities for registry publication." ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:name "Geoprocessing Activity Model" ;
    schema:publisher <https://kurrawong.ai> ;
.
