PREFIX cls: <https://def.isotc211.org/class/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX ex: <http://example.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX ont: <http://example.org/regcat>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ont:
    a owl:Ontology ;
    owl:versionIRI <http://example.org/regcat/1.0> ;
    owl:versionInfo "1.0" ;
    skos:historyNote "Created for the OGC Open Science Persistent Demonstrator registry catalogue."@en ;
    schema:codeRepository "https://github.com/Kurrawong/ospd-regcat"^^xsd:anyURI ;
    schema:copyrightHolder <https://kurrawong.ai> ;
    schema:copyrightNotice "Copyright 2026 KurrawongAI" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://kurrawong.ai> ;
    schema:dateCreated "2026-08-26"^^xsd:date ;
    schema:dateIssued "2026-08-26"^^xsd:date ;
    schema:dateModified "2026-08-26"^^xsd:date ;
    schema:description "An ontology defining resources published as registered items in registry catalogues."@en ;
    schema:license <https://spdx.org/licenses/Apache-2.0.html> ;
    schema:name "Registry Catalogue Model"@en ;
    schema:publisher <https://kurrawong.ai> ;
    ex:qualifiedStatus [
        schema:value istatus:stable ;
        schema:memberOf demo:models ;
    ] ;
.

ex:RegisteredResource
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        dcat:Resource ,
        cls:RegisterItem ;
    skos:definition "A resource that is an item in a managed register and is described in a catalogue."@en ;
    skos:example "A registered geoprocessing activity is an instance of Registered Resource."@en ;
    skos:historyNote "Defined for the OGC Open Science Persistent Demonstrator registry catalogue."@en ;
    skos:prefLabel "Registered Resource"@en ;
.
