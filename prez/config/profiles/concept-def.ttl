PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX exp: <https://example.com/profile/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

exp:ConceptDefProfile
    a
        prof:Profile ,
        sh:NodeShape ,
        prez:ObjectProfile ;
    dcterms:description "Displays only definitions for Concepts" ;
    dcterms:identifier "conceptdef"^^xsd:token ;
    dcterms:title "Concept Def" ;
    altr-ext:constrainsClass skos:Concept ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/ld+json" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path skos:definition ;
        ] ;
.
