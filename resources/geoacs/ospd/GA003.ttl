PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

demo:GA003
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA002 ;
    skos:related demo:GA004 ;
    prov:qualifiedAttribution 
        [
            prov:agent
                [
                    schema:name "Nicholas Car" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ,
        [
            prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.envelope.html> ;
    schema:description "Envelope is a Geoprocessing Activity that returns the smallest rectangle with sides parallel to the coordinate axes that contains all the vertecies of an input geometry" ;
    schema:name "Envelope" ;
.
