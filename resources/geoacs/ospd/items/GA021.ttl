demo:GA021
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf demo:grass-gis-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:gdal-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:arcgis-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:ai-dggs-fii-workflow-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA030 ;
    skos:related 
        demo:GA035 ,
        demo:GA022 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://grass.osgeo.org/grass-stable/manuals/r.slope.aspect.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Derives the rate of elevation change for each cell in an input elevation raster, expressed as degrees or percent." ;
    schema:name "Slope derivation" ;
    schema:version "3" ;
.
