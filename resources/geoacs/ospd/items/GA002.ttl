PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA002
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    schema:citation <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.boundary.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Boundary is a Geoprocessing Activity that returns a polygon containing the vertecies of an input geometry without any interoir rings" ;
    schema:name "Boundary" ;
    schema:version "2" ;
.
