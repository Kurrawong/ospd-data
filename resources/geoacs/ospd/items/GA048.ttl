PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA048
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:related
        demo:GA047 ,
        demo:GA049 ;
    prov:qualifiedAttribution 
        [
            prov:agent
                [
                    schema:email "abostic@voyagersearch.com"^^xsd:anyURI ;
                    schema:name "Alex Bostic" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ,
        [
            prov:agent
                [
                    schema:name "Voyager Search" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://github.com/voyagersearch/voyager-prov-ts/blob/dev/docs/ospd-register-proposal.md> ;
    schema:dateModified "2026-09-23"^^xsd:date ;
    schema:description "Umbrella Geoprocessing Activity type for pipeline-side operations that extract, classify, geotag, and normalize document metadata for downstream discovery. Groups NLP Entity Extraction, Geotag, Commodity Classification, Region Classification, Field Normalization." ;
    schema:name "Text Metadata Enrichment" ;
    schema:url demo:text-metadata-enrichment ;
    schema:version "v1" ;
.
