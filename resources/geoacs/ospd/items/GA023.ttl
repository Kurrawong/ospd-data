PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA023
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf demo:grass-gis-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:gdal-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:arcgis-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:ai-dggs-fii-workflow-geoacs ;
            schema:value istatus:experimental ;
        ]  ;
    skos:broader demo:GA031 ;
    skos:related
        demo:GA022 ,
        demo:GA024 ,
        demo:GA025 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://pro.arcgis.com/en/pro-app/2.6/tool-reference/raster-analysis/an-overview-of-the-hydrology-toolset.htm> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Calculates the accumulated upstream contribution for each cell by following an input D8 flow-direction raster." ;
    schema:name "D8 flow-accumulation derivation" ;
    schema:version "3" ;
.
