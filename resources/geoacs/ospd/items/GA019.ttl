PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA019
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    prov:qualifiedAttribution 
        [
            prov:agent demo:martin-pontius ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ;
    schema:citation <https://shapely.readthedocs.io/en/stable/reference/shapely.difference.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Calculate the difference between two geometries." ;
    schema:name "Difference" ;
    schema:version "2" ;
.
