PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA029
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf
                [
                    rdfs:label "OGC DGGS" ;
                ] ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf
                [
                    rdfs:label "AI-DGGS workflow" ;
                ] ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA033 ;
    skos:related
        demo:GA027 ,
        demo:GA028 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://www.ogc.org/standards/dggs/> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Quantizes input spatial positions or geometries to cells at a specified resolution in a Discrete Global Grid System and returns the corresponding cell identifiers." ;
    schema:name "DGGS cell indexing" ;
    schema:version "2" ;
.
