PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA026
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf
                [
                    rdfs:label "AI-DGGS FII workflow" ;
                ] ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf
                [
                    rdfs:label "GRASS GIS" ;
                ] ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf
                [
                    rdfs:label "GDAL" ;
                ] ;
            schema:value istatus:experimental ;
        ] ,
        [
            schema:memberOf
                [
                    rdfs:label "ArcGIS" ;
                ] ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA032 ;
    skos:related
        demo:GA025 ,
        demo:GA028 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://gdal.org/en/stable/programs/gdal_raster_proximity.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Calculates the shortest distance from each raster cell to the nearest input feature, such as a stream or other vector or raster feature." ;
    schema:name "Distance-to-feature calculation" ;
    schema:version "2" ;
.
