PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA012
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA008 ;
    prov:qualifiedAttribution
        [
            prov:agent demo:martin-pontius ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ;
    schema:citation <https://en.wikipedia.org/wiki/Soil-adjusted_vegetation_index> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Soil-adjusted vegetation index (SAVI)" ;
    schema:name "SAVI" ;
    schema:version "2" ;
.
