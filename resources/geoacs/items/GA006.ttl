PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA006
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:related demo:GA005 ;
    prov:qualifiedAttribution 
        [
            prov:agent
                [
                    schema:name "Nicholas Car" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ,
        [
            prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.convex_hull.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Convex Hull is a Geoprocessing Activity that returns the smallest convex polygon containing all the vertecies in an input geometry, unless the number of vertecies in the input geometry is less than three. For two points, the concave hull collapses to a line; for one, a point." ;
    schema:name "Convex Hull" ;
    schema:version "2" ;
.
