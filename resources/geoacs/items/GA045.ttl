PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA045
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf demo:ospd-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA049 ;
    skos:related demo:GA046 ;
    prov:qualifiedAttribution 
        [
            prov:agent
                [
                    schema:name "Voyager Search" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ,
        [
            prov:agent
                [
                    schema:email "abostic@voyagersearch.com"^^xsd:anyURI ;
                    schema:name "Alex Bostic" ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ;
    schema:citation <https://github.com/voyagersearch/voyager-prov-ts/blob/dev/docs/ospd-register-proposal.md> ;
    schema:dateModified "2026-09-23"^^xsd:date ;
    schema:description "Hybrid Solr search over the enriched index (semantic + lexical). Emitted by the mastra voyager-search tool as the first activity of a Retrieval-Augmented Generation cycle." ;
    schema:name "Retrieve" ;
    schema:url demo:retrieve ;
    schema:version "v1" ;
.
