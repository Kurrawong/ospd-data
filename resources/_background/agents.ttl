PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://def.isotc211.org/org/tc211>
    a schema:Organization ;
    schema:description "The International Organization for Standardization's Technical Committee on \"Geographic information/Geomatics\", charged with standardization in the field of digital geographic information" ;
    schema:name "ISO's Technical Committee 211" ;
    schema:url "https://www.iso.org/committee/54904.html"^^xsd:anyURI ;
.

<https://defs.opengis.net/org/ogc>
    a schema:Organization ;
    schema:name "Open Geospatial Consortium" ;
    schema:url "https://www.ogc.org/"^^xsd:anyURI ;
.

<https://eea>
    a schema:Organization ;
    schema:name "European Environment Agency" ;
    schema:url "https://www.eea.europa.eu/en"^^xsd:anyURI ;
.

<https://kurrawong.ai>
    a schema:Organization ;
    schema:name "Kurrawong AI" ;
    schema:url "https://kurrawong.ai"^^xsd:anyURI ;
.

<https://mepgt>
    a schema:Organization ;
    schema:name "Croatian Ministry of Environmental Protection and Green Transition" ;
    schema:url "https://mzozt.gov.hr/"^^xsd:anyURI ;
.
