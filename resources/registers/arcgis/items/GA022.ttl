PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX iso19135: <http://def.isotc211.org/ont/19135/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA022
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/arcgis> ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA031 ;
    skos:related
        demo:GA023 ,
        demo:GA034 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://pro.arcgis.com/en/pro-app/3.3/tool-reference/spatial-analyst/how-flow-direction-works.htm> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Assigns each elevation-raster cell a flow direction toward the steepest downslope neighbour among its eight surrounding cells." ;
    schema:name "D8 flow-direction derivation" ;
    schema:version "3" ;
.
