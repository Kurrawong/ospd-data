PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA028
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/grassgis> ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA032 ;
    skos:related
        demo:GA026 ,
        demo:GA027 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://grass.osgeo.org/grass-stable/manuals/v.what.rast.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Extracts the value of an input raster, or a defined neighbourhood of raster cells, at each input point location." ;
    schema:name "Raster sampling at points" ;
    schema:version "3" ;
.
