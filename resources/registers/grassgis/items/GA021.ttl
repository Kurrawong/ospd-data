PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX iso19135: <http://def.isotc211.org/ont/19135/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA021
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/grassgis> ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA030 ;
    skos:related
        demo:GA022 ,
        demo:GA035 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://grass.osgeo.org/grass-stable/manuals/r.slope.aspect.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Derives the rate of elevation change for each cell in an input elevation raster, expressed as degrees or percent." ;
    schema:name "Slope derivation" ;
    schema:version "3" ;
.
