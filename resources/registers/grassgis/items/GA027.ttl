PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX iso19135: <https://def.isotc211.org/ont/19135/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA027
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/grassgis> ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:GA032 ;
    skos:related
        demo:GA028 ,
        demo:GA036 ;
    prov:qualifiedAttribution
        [
            prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:citation <https://grass.osgeo.org/grass-stable/manuals/r.stats.zonal.html> ;
    schema:dateModified "2026-09-17"^^xsd:date ;
    schema:description "Calculates summary statistics, such as mean, median, minimum or maximum, for raster cells within each input polygon or grid zone." ;
    schema:name "Zonal raster statistics" ;
    schema:version "3" ;
.
