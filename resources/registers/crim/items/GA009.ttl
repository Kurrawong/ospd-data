PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX iso19135: <https://def.isotc211.org/ont/19135/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA009
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/crim> ;
            schema:value istatus:experimental ;
        ] ;
    skos:related
        [
            a schema:CreativeWork ;
            rdfs:label "STAC MLM" ;
            schema:description "A machine learning model description format for STAC." ;
            schema:url <https://stac-extensions.github.io/mlm/> ;
            schema:codeRepository <https://github.com/stac-extensions/mlm> ;
        ] ;
    prov:qualifiedAttribution
        [
            prov:agent
                [
                    a schema:Person ;
                    schema:affiliation <https://www.luqia.ca> ;
                    schema:email <mailto:francis.charette-migneault@luqia.ca> ;
                    schema:name "Francis Charette-Migneault" ;
                    schema:sameAs <https://orcid.org/0000-0003-4862-3349> ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ,
        [
            prov:agent
                [
                    a schema:SoftwareApplication ;
                    schema:codeRepository <https://github.com/crim-ca/weaver> ;
                    schema:name "OGC API Processes - Weaver" ;
                    prov:atLocation <https://hirondelle.crim.ca/weaver> ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    schema:url <https://hirondelle.crim.ca/weaver/processes/ogc-ospd2026-downscaling-unet> ;
    schema:dateModified "2026-10-09"^^xsd:date ;
    schema:description "Performs climate variable downscaling used to transform coarse-scale climate model outputs into high-resolution, locally relevant climate data, using a machine learning algorithm described through STAC MLM." ;
    schema:name "ML Climate Variable Downscaling" ;
    schema:version "0.1.3.dev10" ;
.
