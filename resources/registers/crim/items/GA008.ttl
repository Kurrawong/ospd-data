PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX iso19135: <https://def.isotc211.org/ont/19135/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

demo:GA008
    a
        iso19135:RegisterItem ,
        ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf <http://w3id.org/ogc/reg/crim> ;
            schema:value istatus:experimental ;
        ] ;
    prov:qualifiedAttribution
        [
            prov:agent
                [
                    a schema:SoftwareApplication ;
                    schema:codeRepository <https://github.com/crim-ca/weaver> ;
                    schema:name "OGC API Processes - Weaver" ;
                    prov:atLocation <https://hirondelle.crim.ca/weaver> ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ,
        [
            prov:agent
                [
                    a schema:Person ;
                    schema:affiliation <https://www.luqia.ca> ;
                    schema:email <mailto:francis.charette-migneault@luqia.ca> ;
                    schema:name "Francis Charette-Migneault" ;
                    schema:sameAs <https://orcid.org/0000-0003-4862-3349> ;
                ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ;
        ] ;
    schema:url <https://hirondelle.crim.ca/weaver/processes/calculate-band> ;
    schema:dateModified "2026-10-09"^^xsd:date ;
    schema:description "Performs a calculation over imagery bands and returns the resulting raster using the specified band arithmetic." ;
    schema:name "Band Calculation" ;
    schema:version "1.1.0" ;
.
