PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex: <http://example.org/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX roles: <https://prez.dev/ManifestResourceRoles/>
PREFIX schema: <https://schema.org/>

[]    a <https://prez.dev/Manifest> ;
    prof:hasResource
        [
            prof:hasArtifact "_background/*.ttl" ;
            prof:hasRole roles:CompleteCatalogueAndResourceLabels ;
        ] ,
        [
            prof:hasArtifact "geoacs/_cat.ttl" ;
            prof:hasRole roles:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "geoacs/items/*.ttl" ;
            prof:hasRole roles:ResourceData ;
            schema:additionalType ex:GeoprocessingActivity ;
        ] ,
        [
            prof:hasArtifact "models/_cat.ttl" ;
            prof:hasRole roles:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo <https://linked.data.gov.au/def/ontpub/validator> ;
            prof:hasArtifact
                "models/geoac.ttl" ,
                "models/regcat.ttl" ;
            prof:hasRole roles:ResourceData ;
        ] ,
        [
            prof:hasArtifact "vocabs/_cat.ttl" ;
            prof:hasRole roles:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo <https://linked.data.gov.au/def/vocpub/validator> ;
            prof:hasArtifact
                "vocabs/RegisterItemStatus.ttl" ,
                "vocabs/RegisterRolesDemo.ttl" ;
            prof:hasRole roles:ResourceData ;
        ] ;
.
