PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>

demo:models
    a
        dcat:Catalog ,
        ex:TopLevelCatalog ;
    dcterms:hasPart
        <http://example.org/geoac> ,
        <http://example.org/regcat> ;
    prov:qualifiedAttribution
        [
            prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RegisterRolesDemo/register-owner> ;
        ] ;
    schema:author <https://kurrawong.ai> ;
    schema:name "Models Catalogue" ;
.
