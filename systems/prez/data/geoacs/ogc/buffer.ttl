PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX schema: <https://schema.org/>

demo:buffer
    a ex:GeoprocessingActivity ;
    schema:name "Buffer" ;
    ex:qualifiedStatus [
        schema:value istatus:stable ;
        schema:memberOf demo:ogc-geoacs ;
    ] ;
    dcterms:isPartOf demo:ogc-geoacs ;
.
