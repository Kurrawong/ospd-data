PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

demo:rapid-river-detection
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus
        [
            schema:memberOf demo:cro-geoacs ;
            schema:value istatus:experimental ;
        ] ;
    skos:broader demo:river-detection ;
    schema:name "Rapid River Detection" ;
.
