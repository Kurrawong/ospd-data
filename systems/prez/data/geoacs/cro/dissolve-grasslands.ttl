PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

demo:dissolve-grasslands
    a ex:GeoprocessingActivity ;
    ex:qualifiedStatus 
        [
            schema:memberOf demo:ogc-geoacs ;
            schema:value istatus:submitted ;
        ] ,
        [
            schema:memberOf demo:cro-geoacs ;
            schema:value istatus:stable ;
        ] ;
    skos:broader demo:dissolve ;
    schema:name "Dissolve Grasslands" ;
.
