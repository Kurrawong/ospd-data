PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>

demo:euro-geoacs
    a dcat:Catalog ;
    prov:qualifiedAttribution
        [
            prov:agent <https://eea> ;
            prov:hadRole <https://def.isotc211.org/codeset/RegisterRolesDemo/register-owner> ;
        ] ;
    schema:author <https://kurrawong.ai> ;
    schema:name "Euro Geoprocessing Activities Register" ;
    ex:qualifiedStatus [
        schema:value istatus:stable ;
        schema:memberOf demo:geoacs ;
    ] ;
.
