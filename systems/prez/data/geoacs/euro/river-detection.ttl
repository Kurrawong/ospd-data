PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX istatus: <https://def.isotc211.org/codeset/ItemStatus/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

demo:river-detection
    a ex:GeoprocessingActivity ;
    schema:name "River Detection" ;
    ex:qualifiedStatus [
        schema:value istatus:stable ;
        schema:memberOf demo:euro-geoacs ;
    ] ;
    skos:broader demo:waterbody-detection ;
.
