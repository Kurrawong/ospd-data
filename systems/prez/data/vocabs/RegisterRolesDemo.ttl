PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX demo: <http://ospd/demo/>
PREFIX ex: <http://example.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX regrol: <https://def.isotc211.org/codeset/RegisterRolesDemo>
PREFIX regrols: <https://def.isotc211.org/codeset/RegisterRolesDemo/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

regrols:control-body
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "Makes the technical or content decisions on whether proposed changes are acceptable."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Control Body"@en ;
    skos:topConceptOf regrol: ;
.

regrols:register-manager
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "Runs the register on behalf of the owner: receives and manages proposals, maintains the register content and acts as the administrative point of contact."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Register Manager"@en ;
    skos:topConceptOf regrol: ;
.

regrols:register-owner
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "Ultimate authority for the register: establishes it and has primary responsibility for its management, dissemination and intellectual content."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Register Owner"@en ;
    skos:topConceptOf regrol: ;
.

regrols:register-user
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "Accesses the registry to use the contents of one or more registers."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Register User"@en ;
    skos:topConceptOf regrol: ;
.

regrols:registry-manager
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "Operates the registry, i.e. the information system in which one or more registers are maintained."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Registry Manager"@en ;
    skos:topConceptOf regrol: ;
.

regrols:submitting-organization
    a skos:Concept ;
    dcterms:provenance "Defined for the Register Roles vocabulary."@en ;
    rdfs:isDefinedBy regrol: ;
    skos:definition "An organisation authorised or qualified to propose additions or other changes to register content."@en ;
    skos:inScheme regrol: ;
    skos:prefLabel "Submitting Organization"@en ;
    skos:topConceptOf regrol: ;
.

regrol:
    a skos:ConceptScheme ;
    skos:definition "Roles performed by organisations and other parties in the governance, management, operation and use of registers and registries."@en ;
    skos:hasTopConcept
        regrols:control-body ,
        regrols:register-manager ,
        regrols:register-owner ,
        regrols:register-user ,
        regrols:registry-manager ,
        regrols:submitting-organization ;
    skos:historyNote "This vocabulary is expressed for the first time here"@en ;
    skos:prefLabel "Register Roles"@en ;
    schema:creator <https://def.isotc211.org/org/tc211> ;
    schema:dateCreated "2026-08-21"^^xsd:date ;
    schema:dateModified "2026-08-21"^^xsd:date ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:publisher <https://def.isotc211.org/org/tc211> ;
    dcterms:isPartOf demo:vocs ;
    ex:qualifiedStatus [
        schema:value istatus:stable ;
        schema:memberOf demo:vocabs ;
    ] ;
.
